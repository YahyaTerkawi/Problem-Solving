class program
{

    static void PrintInvertedPattern(int number)
    {
        for (int i = number; i >= 1; i--)
        {
            for (int j = 1; j <=i; j++)
            {
                Console.Write($"  {i}");
            }
            Console.WriteLine();
        }
    }


    static void Main(string[] args)
    {
        PrintInvertedPattern(9);
    }
}
